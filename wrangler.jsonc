{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ora-store",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CLOUDFLARE_WORKERS": "1",
    "VITE_SUPABASE_URL": "https://xoipahpyxatdafhqkzcr.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ytRHrbqljOuGSAvWWlWIeg_5ZRXJWBL"
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "ORA_MEDIA_R2",
      "bucket_name": "ora-store-images"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
