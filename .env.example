# O-RA STORE - LOCAL + CLOUDFLARE/SUPABASE ENVIRONMENT

# AI (optional; add only the providers you use)
GEMINI_API_KEY=""
GEMINI_ASSISTANT_MODEL="gemini-3.6-flash"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Supabase (required)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
# Server-only secret. Never prefix this with VITE_.
SUPABASE_SECRET_KEY="sb_secret_your_key"

# O-RA staff login bootstrap (required for the first fresh database)
ORA_SUPER_ADMIN_PASSWORD="replace-with-a-strong-private-password"
ORA_DEFAULT_STAFF_PASSWORD="replace-with-a-strong-private-password"
STAFF_SESSION_SECRET="replace-with-a-long-random-private-string"
ABUSE_HASH_SALT="replace-with-a-different-long-random-private-string"

# Cloudflare runtime marker is already set in wrangler.jsonc for live Worker use.
# Do not add live secret values to wrangler.jsonc.

# Google Sheets is normally saved from O-RA Store Settings.
VITE_GOOGLE_SHEET_WEBHOOK_URL=""

# Fardar (leave empty until API access is issued)
FARDAR_API_URL=""
FARDAR_API_KEY=""
FARDAR_ACCOUNT_ID=""
FARDAR_WAYBILL_PATH="/waybills"
FARDAR_AUTH_HEADER="Authorization"
FARDAR_AUTH_PREFIX="Bearer "
FARDAR_WAYBILL_RESPONSE_FIELD="waybill"
FARDAR_REQUEST_TEMPLATE_JSON=""
